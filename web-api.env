# Wep API server settings
PORT=5000
FORCEHTTPS=false
RSA_PASSPHRASE=PASTE_RSA_SECRET
# Set ENCRYPTION_KEY to the same value as RSA_PASSPHRASE
# Keep both values for now; RSA_PASSPHRASE will be removed in a future release
ENCRYPTION_KEY=PASTE_ENCRYPTION_KEY
APPLICATION_LICENSE_KEY=PASTE_LICENSE_KEY


# Email settings
EMAIL_FROMNAME=My Company Support
EMAIL_FROMADDRESS=support@mycompany.com
EMAIL_SIGNATURE=<p>Thanks,<br>The Company Team</p>

#SMTP_HOST=
#SMTP_PORT=
#SMTP_ENABLESSL=true
#SMTP_USERNAME=
#SMTP_PASSWORD=

# Error monitoring
#BUGSNAG_APIKEY=

# App metrics (OpenTelemetry)
# NEW_RELIC_APP_NAME is only needed when exporting to New Relic
#NEW_RELIC_APP_NAME=
#OTEL_EXPORTER_OTLP_ENDPOINT=
#OTEL_ENABLEMETRICS=true
#OTEL_ENABLETRACES=true
# Comma-separated key=value pairs, e.g. api-key=YOUR_BACKEND_API_KEY
#OTEL_EXPORTER_OTLP_HEADERS=

GOOGLE_ANALYTICS_KEY=UA-XXXXXXXX-X


